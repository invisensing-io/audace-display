# The desktop viewer (a Rust crate) is built on its own; it is not part of
# the Python package. Its Python side, audace_display.gui_worker, is.
prune gui
# Agent worktrees and scratch, never shipped.
prune .claude
# The tests ship (setuptools adds tests/test*.py); their fixtures must too, or
# `pytest` in the unpacked sdist stops at collection (No module named 'conftest').
include tests/conftest.py
